# ============================================================
# .env.example — 将此文件复制为 .env 并填写实际值
# ============================================================

# ── 数据库 ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass_change_me
MYSQL_DATABASE=trpg
MYSQL_USER=trpg
MYSQL_PASSWORD=trpgpass_change_me

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redispass_change_me

# ── JWT ──────────────────────────────────────────────────────
# 生产环境请使用至少 64 字符的随机字符串
# 生成命令: openssl rand -hex 32
JWT_SECRET=changeme_please_use_a_secure_random_string_in_production

# ── Snowflake ID 生成器 ──────────────────────────────────────
# 多实例部署时为每个实例设置唯一的 worker ID（0-1023）
SNOWFLAKE_WORKER_ID=1

# ── 服务器 ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
