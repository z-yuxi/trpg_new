# 生产环境必须配置的环境变量
# 将此文件复制为 .env 并填写真实值，切勿将 .env 提交到版本控制

# ── 数据库 ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=           # MySQL root 密码（高强度随机字符串）
MYSQL_DATABASE=trpg            # 数据库名
MYSQL_USER=trpg                # 数据库用户名
MYSQL_PASSWORD=                # 数据库用户密码（高强度随机字符串）

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=                # Redis 认证密码（高强度随机字符串）

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=                    # JWT 签名密钥（至少 32 位随机字符串）
JWT_REFRESH_SECRET=            # Refresh Token 独立签名密钥（至少 32 位随机字符串）

# ── 应用 ──────────────────────────────────────────────────────
SNOWFLAKE_WORKER_ID=1          # 雪花 ID 工作节点编号（多实例部署时各节点不同）
NODE_ENV=production
